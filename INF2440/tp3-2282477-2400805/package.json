    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.0.5",
    "start-server-and-test": "^2.1.2"
  },
  "dependencies": {
    "http-server": "^14.1.1"
  },
  "jest": {
    "collectCoverageFrom": [
